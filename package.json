{
  "name": "asset-metadata-js",
  "version": "0.1.0",
  "description": "Warthog Asset Metadata — Bun/TypeScript port",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts & esbuild --bundle public/js/app.js --outfile=public/assets/app.js --watch --external:/fonts/* --external:/images/* & tailwindcss -i ./public/css/app.css -o ./public/assets/app.css --watch",
    "build:css": "tailwindcss -i ./public/css/app.css -o ./public/assets/app.css --minify",
    "build:js": "esbuild --bundle public/js/app.js --minify --outfile=public/assets/app.js --external:/fonts/* --external:/images/*",
    "build": "bun run build:css && bun run build:js",
    "start": "bun src/server.ts",
    "test": "bun test",
    "precommit": "bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "esbuild": "^0.20.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
